@model Teacher
@{
    ViewData["Title"] = "Редактировать преподавателя";
}
<div class="page-heading">
    <div><div class="eyebrow">ПРЕПОДАВАТЕЛЬСКИЙ СОСТАВ</div><h1>Редактировать преподавателя</h1><p class="page-subtitle">Заполните данные сотрудника университета.</p></div>
    <a class="btn-secondary-app" asp-action="Index">← К списку преподавателей</a>
</div>
<section class="form-card">
    <div class="form-card-heading"><span class="form-icon cyan">♙</span><div><h3>Личные данные</h3><p>Укажите ФИО и кафедру преподавателя.</p></div></div>
    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
        <div class="form-group-app"><label asp-for="FullName"></label><input asp-for="FullName" class="form-control-app" placeholder="Например, Иванов Иван Иванович" /><span asp-validation-for="FullName" class="field-error"></span></div>
        <div class="form-group-app"><label asp-for="DepartmentId"></label><select asp-for="DepartmentId" asp-items="ViewBag.DepartmentId" class="form-control-app"><option value="0">Выберите кафедру</option></select><span asp-validation-for="DepartmentId" class="field-error"></span></div>
        <div class="form-actions"><a class="btn-secondary-app" asp-action="Index">Отмена</a><button type="submit" class="btn-primary-app">Сохранить</button></div>
    </form>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
