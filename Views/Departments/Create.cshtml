@model Department

@{
    ViewData["Title"] = "Добавить кафедру";
}

<div class="page-heading">
    <div>
        <div class="eyebrow">СТРУКТУРА УНИВЕРСИТЕТА</div>
        <h1>Добавить кафедру</h1>
        <p class="page-subtitle">
            Заполните информацию о подразделении.
        </p>
    </div>
    <a class="btn-secondary-app" asp-action="Index">
        ← К списку кафедр
    </a>
</div>

<section class="form-card">
    <div class="form-card-heading">
        <span class="form-icon violet">▦</span>
        <div>
            <h3>Данные кафедры</h3>
            <p>Поля со звёздочкой обязательны для заполнения.</p>
        </div>
    </div>

    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly"
             class="validation-summary text-danger">
        </div>

        <div class="form-group-app">
            <label asp-for="Name">Название кафедры</label>

            <input asp-for="Name"
                   class="form-control-app"
                   placeholder="Например, Кафедра информационных систем" />

            <span asp-validation-for="Name"
                  class="text-danger">
            </span>
        </div>

        <div class="form-actions">
            <a asp-action="Index" class="btn-secondary-app">
                Отмена
            </a>

            <button type="submit" class="btn-primary-app">
                Сохранить
            </button>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
