@model ErrorViewModel
@{
    ViewData["Title"] = "Ошибка";
}
<section class="form-card">
    <div class="confirm-symbol">!</div>
    <h3>Произошла ошибка</h3>
    <p>Во время обработки запроса возникла непредвиденная ошибка. Попробуйте вернуться на главную страницу.</p>
    @if (Model.ShowRequestId)
    {
        <p>Идентификатор запроса: <code>@Model.RequestId</code></p>
    }
    <a class="btn-primary-app" asp-controller="Home" asp-action="Index">На главную</a>
</section>
